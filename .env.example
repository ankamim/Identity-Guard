# Antigrapse afto to arxeio se ".env" kai sympliros tis times sou.

# Kleidi apo https://serpapi.com  (dorean plano: 250 anazitiseis/mina)
SERPAPI_KEY=

# Pou trexei to DeepSafe. Me `make start` sto fakelo tou DeepSafe,
# to default einai afto.
DEEPSAFE_URL=http://localhost:8000

# voting | average | stacking
DEEPSAFE_ENSEMBLE=voting
